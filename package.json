{
  "name": "tss-realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "portless ws.tss --app-port 3331 node --import tsx --watch src/index.ts",
    "start": "portless ws.tss --app-port 3331 node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.0.10",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
